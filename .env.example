# Públicas (embutidas no bundle do navegador)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Somente para supabase/functions (Edge Functions) — nunca prefixar com VITE_
